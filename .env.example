# ------------------------------------------------------------------
# PowerX Nutrition — environment variables
# Copy this file to .env.local (local) or add them in Vercel →
# Project → Settings → Environment Variables (production).
# Only ADMIN_PASSWORD + ADMIN_SESSION_SECRET are required to run locally.
# ------------------------------------------------------------------

# Public URL of the site (SEO, sitemap, receipt links sent on WhatsApp)
NEXT_PUBLIC_SITE_URL=https://powerxnutrition.in

# WhatsApp number that receives orders: country code + number, digits only
NEXT_PUBLIC_WHATSAPP_NUMBER=919710235320

# UPI — payee address and name shown in the UPI app (website + POS QR)
NEXT_PUBLIC_UPI_ID=vinothkumar040996@ibl
NEXT_PUBLIC_UPI_NAME=VINOTHKUMAR SARAVANAN

# Contact details shown on the site
NEXT_PUBLIC_CONTACT_PHONE=9710235320
NEXT_PUBLIC_CONTACT_PHONE_2=6382392230
NEXT_PUBLIC_CONTACT_EMAIL=powerxbaasha@gmail.com

# Delivery charges (₹). Orders at or above FREE_DELIVERY_ABOVE ship free.
NEXT_PUBLIC_DELIVERY_CHARGE=79
NEXT_PUBLIC_FREE_DELIVERY_ABOVE=999
# Cash on Delivery only within this many km of the shop
NEXT_PUBLIC_COD_RADIUS_KM=5

# ---------------- Admin / staff login (SERVER ONLY — never prefix with NEXT_PUBLIC_)
# Owner logs in with username "owner" + this password. Other staff get their own logins in Settings.
ADMIN_PASSWORD=change-me
# Long random string (64+ chars) that signs login cookies and customer receipt links
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# ---------------- Database
# Empty = built-in local Postgres (PGlite) stored in ./data/db — perfect for a shop PC / any Node host.
# REQUIRED on Vercel/serverless: a Postgres connection string, e.g. Supabase (free) →
# Project Settings → Database → Connection string → "Transaction pooler" (port 6543) URI.
DATABASE_URL=
# PGLITE_DATA_DIR=./data/db

# ---------------- File storage (optional locally, REQUIRED on Vercel)
# Supabase Storage for product photos (public bucket) and supplier invoices (private bucket).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------- AI invoice reading (optional, FREE options) — pick ONE
# 1) Google Gemini free tier: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# 2) Any OpenAI-compatible endpoint — e.g. Ollama running free on the shop PC:
#    AI_BASE_URL=http://localhost:11434/v1   AI_MODEL=qwen2.5vl   (no key needed)
#    or Groq / OpenRouter free models (needs AI_API_KEY)
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Without any of these, invoices are read by the free built-in text reader / OCR.

# ---------------- Product photo search (optional)
# Open Food Facts is used automatically (free, no key).
# Google Programmable Search (100 free queries/day): create a search engine limited to brand /
# supplier sites at https://programmablesearchengine.google.com, enable "Image search".
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ---------------- Online payment gateway (optional — UPI QR + COD work without it)
# Razorpay (no monthly fee; per-transaction charges). Dashboard → Settings → API keys / Webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------- WhatsApp bill PDF — fully automatic sending (optional)
# Without these, "Send" opens WhatsApp with the message + PDF download link (free; staff press send).
# With these, the PDF is delivered to the customer's WhatsApp automatically via Meta's official
# WhatsApp Business Cloud API (Meta charges a small fee per message). NEXT_PUBLIC_SITE_URL must be
# your public https site so WhatsApp can download the PDF.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template: header = DOCUMENT, body e.g. "Hi {{1}}, thanks for shopping at PowerX Nutrition. Your bill {{2}} for {{3}} is attached."
WHATSAPP_BILL_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=en
